# Base de données PostgreSQL
DATABASE_URL="postgresql://diotytio:CHANGEZ_MOI@localhost:5436/diotytio?schema=public"

# Docker PostgreSQL (docker compose)
POSTGRES_USER=diotytio
POSTGRES_PASSWORD=ChangezMoiFort123!
POSTGRES_DB=diotytio
POSTGRES_PORT=5436

# Origines autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
NODE_ENV=development

# GeniusPay API Keys — Récupérez sur https://geniuspay.ci → Paramètres → API
GENIUSPAY_API_KEY=pk_sandbox_XXXX
GENIUSPAY_API_SECRET=sk_sandbox_XXXX

# URLs de redirection
PAYMENT_SUCCESS_URL=http://localhost:5173/payment/success
PAYMENT_ERROR_URL=http://localhost:5173/payment/error

# Admin credentials (min 8 chars, 1 uppercase, 1 digit, 1 special)
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=ChangezCeMotDePasse123!

# Port du serveur
PORT=3001

# Webhook secret (configurez dans GeniusPay dashboard)
WEBHOOK_SECRET=your_webhook_secret_here

# URL de l API en production (laisser vide si frontend+backend même origine)
VITE_API_URL=
